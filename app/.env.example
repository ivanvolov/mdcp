# Copy to .env and fill in. No vault/Infisical involved — plain env only.

# RPC (any mainnet/sepolia provider; Alchemy shown)
ALCHEMY_API_KEY=
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/${ALCHEMY_API_KEY}

# Uniswap Trading API key — developers.uniswap.org -> dashboard
UNISWAP_API_KEY=

# Live Sepolia demo wallet (throwaway! never real funds)
SEPOLIA_BURNER_PK=
SEPOLIA_BURNER_ADDRESS=

# Optional overrides (defaults shown)
# RPC_URL=http://127.0.0.1:8545      # chain the tools talk to
# PRIVATE_KEY=                        # defaults to anvil test account #0
# STATE_DIR=.state
# BENCH_LOG=

# Hedera testnet burner operator (throwaway! testnet only).
# Generate: node -e "import('@hiero-ledger/sdk').then(({PrivateKey})=>{const k=PrivateKey.generateECDSA();console.log(k.toStringRaw(),'0x'+k.publicKey.toEvmAddress())})"
# Fund the EVM alias at https://portal.hedera.com/faucet (100 testnet HBAR).
# HEDERA_OPERATOR_ID is optional — resolved from the mirror node by alias.
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_KEY=
HEDERA_OPERATOR_EVM=

# --- The Graph -------------------------------------------------------------
# Subgraph Studio key: thegraph.com/studio -> API Keys tab. Needed for graph.*
# NOTE: this is the Gateway API key, NOT a subgraph deploy key. The deploy key
# returns "auth error: API key not found" on every query.
GATEWAY_API_KEY=
# Optional: path to a locally built graphops/subgraph-mcp binary.
# Leave empty and mdcp bridges to the hosted SSE service via `npx mcp-remote`
# (zero install, slower start). No Rust toolchain required either way.
# SUBGRAPH_MCP_BIN=

# --- Hedera mirror-node MCP upstream (read-only, no HBAR) -------------------
# Path to hedera-dev/mirrornode-mcp-server's stdio entrypoint. See
# app/bench/upstream/README.md — their SSE endpoint answers 500, so we serve
# their own tool definitions over stdio instead.
# MIRRORNODE_MCP_BIN=/abs/path/to/mirrornode-mcp-server/stdioServer.mjs

# --- Capability profile -----------------------------------------------------
# uniswap | hedera | graph | all. Unset = whatever the per-family flags enable.
# Reviewers looking at one sponsor track should set this to that track.
# MDCP_PROFILE=
