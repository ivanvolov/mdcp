# Copy to .env and fill in. No vault/Infisical involved — plain env only.

# RPC (any mainnet/sepolia provider; Alchemy shown)
ALCHEMY_API_KEY=
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/${ALCHEMY_API_KEY}

# Uniswap Trading API key — developers.uniswap.org -> dashboard
UNISWAP_API_KEY=

# Live Sepolia demo wallet (throwaway! never real funds)
SEPOLIA_BURNER_PK=
SEPOLIA_BURNER_ADDRESS=

# Optional overrides (defaults shown)
# RPC_URL=http://127.0.0.1:8545      # chain the tools talk to
# PRIVATE_KEY=                        # defaults to anvil test account #0
# STATE_DIR=.state
# BENCH_LOG=
